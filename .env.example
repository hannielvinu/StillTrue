APP_ENV=dev
MOCK_MODE=false
BIFROST_BASE_URL=http://localhost:8080
BIFROST_VIRTUAL_KEY=
TAVILY_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Free-tier setup used for the measured benchmark (Groq + NVIDIA through Bifrost):
GROQ_API_KEY=
NVIDIA_API_KEY=
EXTRACTOR_MODEL=groq/openai/gpt-oss-20b
VERIFIER_MODEL_A=groq/openai/gpt-oss-120b
VERIFIER_MODEL_B=nvidia/nvidia/nemotron-3.5-lightning-30b-a3b
FALLBACK_MODELS=groq/qwen/qwen3.8-27b
TAVILY_DAILY_CREDIT_CAP=200
MAX_CLAIMS_PER_RUN=8
MAX_INPUT_CHARS=6000
CLAIM_CONCURRENCY=1
TAVILY_TIMEOUT_S=20
LLM_TIMEOUT_S=60
RATE_LIMIT=20/minute
CACHE_TTL_HIGH_H=6
CACHE_TTL_MED_H=72
CACHE_TTL_LOW_H=336
CORS_ORIGINS=http://localhost:5173
CACHE_PATH=.data/evidence.db
